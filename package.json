{
  "name": "dsh-work-modes-probe",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "DSH Work Modes：用户分类管理、AI 访谈建卡与专业角色工作会话",
  "engines": { "node": ">=24.9.0", "dsh": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2" },
  "exports": { ".": "./src/index.js", "./client": "./dist/client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["src", "dist", "roles", "templates", "locale", "licenses", "docs", "CHANGELOG.md", "THIRD_PARTY_NOTICES.md", "icon.svg", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "node scripts/build.mjs", "test": "vitest run --config vitest.config.js", "check": "node scripts/check.mjs" },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0 || ~4.2.0-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2 || 0.2.2-rc.1 || 0.2.2-rc.5 || 0.2.3-alpha.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": { "esbuild": "0.25.12", "vitest": "4.1.11" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"] }
  }
}
